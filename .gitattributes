# Normalize all other text files to LF on checkout. Prevents Windows
# core.autocrlf=true from polluting the diff with CRLF noise across the
# entire tree (1300+ files were once reported modified by line endings
# alone). Pair with `git config core.autocrlf input` for the working tree
# to also stay LF.
* text=auto eol=lf

# Binary fixtures (Git LFS)
tests/fixtures/*.fig filter=lfs diff=lfs merge=lfs -text -eol
tests/fixtures/fonts/*.ttf filter=lfs diff=lfs merge=lfs -text -eol
packages/core/vendor/canvaskit-webgpu/*.wasm filter=lfs diff=lfs merge=lfs -text -eol
